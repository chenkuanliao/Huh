# Optional overrides. Defaults work for a local personal installation.
PORT=8787
CHATGPT_CALLBACK_PORT=1457
POSTGRES_PASSWORD=huh-local-database
# Leave blank to generate and retain a secret in the data volume.
SECRET_KEY=
# Use true when exclusively accessing through HTTPS/Tailscale.
COOKIE_SECURE=false
# Comma-separated HTTPS origins when a reverse proxy terminates TLS.
# Example: https://your-pc.your-tailnet.ts.net:8787
ALLOWED_ORIGINS=
